# Application Packages & AppImages
dist/
RetakAlium.AppDir/
*.AppImage
*.sfs
*.iso

# Python Packaging & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
pypi_package/dist/
pypi_package/build/
pypi_package/src/*.egg-info/
.venv/
venv/

# Upstream Source & C++/CMake Build Files
krita/
build/
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib

# Temporary & Editor Files
.vscode/
.idea/
*.swp
*~
.DS_Store
*.log
/tmp/
